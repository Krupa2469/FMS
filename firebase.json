{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      ".git",
      ".git/**",
      "**/.git/**",
      ".firebase",
      ".firebase/**",
      ".vscode",
      ".vscode/**",
      "**/node_modules/**",
      "functions/**",
      "firebase-functions/**",
      "**/*.zip",
      "**/*.txt",
      "**/*.md",
      "package.json",
      "package-lock.json"
    ],
    "cleanUrls": true
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
