rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {
    // DEVELOPMENT RULES FOR FMS CLIENT-SIDE TESTING.
    // Replace with authenticated role-based rules before production public rollout.
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2027, 12, 31);
    }
  }
}
